# ==========================================================
# AI Database Analyst - Environment Configuration
# Copy this file to ".env" and fill in your values.
# ==========================================================

# ---- AI Provider ----
# Options: "openai" or "gemini"
AI_PROVIDER=openai

# ---- OpenAI ----
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# ---- Google Gemini ----
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-flash

# ---- App ----
# Path to a default SQLite database (optional). If empty, a sample
# database is auto-generated on first run.
DEFAULT_DB_PATH=
